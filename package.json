        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
