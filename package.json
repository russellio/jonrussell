        "@russellio/vue-background-stars": "^1.4.0",
        "@sentry/vue": "^10.75.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.9",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^2.1.0",
        "pinia": "^3.0.4",
        "tailwind-merge": "^3.7.0",
