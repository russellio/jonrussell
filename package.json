{
    "name": "jonrussell-portfolio",
    "version": "1.2.4",
    "private": true,
    "type": "module",
    "description": "Modern portfolio website built with Laravel, Vue.js, and Tailwind CSS",
    "packageManager": "pnpm@11.21.0",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "test:ssr": "node tests/ssr/render-smoke.mjs",
        "types:check": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@types/node": "^22.20.5",
        "@vue/eslint-config-typescript": "^14.9.0",
        "alpinejs": "^3.17.5",
        "autoprefixer": "^10.6.2",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^9.33.0",
        "postcss": "^8.5.32",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "stylelint": "^16.26.1",
        "stylelint-config-standard": "^39.0.1",
        "stylelint-config-tailwindcss": "^1.0.1",
        "typescript-eslint": "^8.72.1",
        "vue-tsc": "^2.2.12"
    },
    "dependencies": {
        "@fontsource-variable/noto-sans": "^5.3.0",
        "@fontsource-variable/sixtyfour": "^5.3.0",
        "@fontsource-variable/sixtyfour-convergence": "^5.3.0",
        "@fontsource/sixtyfour": "^5.3.0",
        "@fontsource/space-mono": "^5.3.0",
        "@iconify-json/lucide": "^1.2.149",
        "@iconify-json/simple-icons": "^1.2.101",
        "@inertiajs/vue3": "^2.3.29",
        "@nuxt/ui": "^4.12.0",
        "@russellio/vue-background-stars": "^1.4.0",
        "@sentry/vue": "^10.78.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.10",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^2.1.0",
        "pinia": "^3.0.4",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^7.3.7",
        "vue": "3.5.43",
        "vue-gtag": "^3.7.1",
        "vue-router": "^5.4.0",
        "zod": "^4.6.7"
    }
